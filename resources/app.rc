#include <winresrc.h>
#include "resource.h"

// Generated by CMake into the build tree from version.txt -- see resources/version.h.in.
#include "pp_version.h"

#pragma code_page(65001)

// The manifest asks for per-monitor-v2 DPI awareness, visual styles and a UTF-8 code page.
// It is embedded here rather than generated by the linker (see /MANIFEST:NO in CMakeLists).
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDI_APP ICON "app.ico"

// Default notification sounds. Custom user sounds are read from disk instead; these are the
// fallback, and are also what "Reset to default" restores.
IDW_SOUND_CONNECTED     RCDATA "sounds/connected.wav"
IDW_SOUND_DISCONNECTED  RCDATA "sounds/disconnected.wav"
IDW_SOUND_LOW           RCDATA "sounds/low.wav"
IDW_SOUND_CRITICAL      RCDATA "sounds/critical.wav"
IDW_SOUND_CHARGED       RCDATA "sounds/charged.wav"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     PP_VERSION_RC_FILEVERSION
    PRODUCTVERSION  PP_VERSION_RC_FILEVERSION
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS       VS_FF_DEBUG
#else
    FILEFLAGS       0x0L
#endif
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "k0te1ch"
            VALUE "FileDescription",  "PowerPeek device battery monitor"
            VALUE "FileVersion",      PP_VERSION_RC_STRING
            VALUE "InternalName",     "PowerPeek"
            VALUE "LegalCopyright",   "Copyright (C) 2026 k0te1ch. GPL-3.0-or-later."
            VALUE "OriginalFilename", "PowerPeek.exe"
            VALUE "ProductName",      "PowerPeek"
            VALUE "ProductVersion",   PP_VERSION_RC_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
